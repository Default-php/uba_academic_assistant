# SECRET_KEY: genera una con:
# .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# DEBUG: 1 en desarrollo, 0 en producción
DEBUG=1

# Hosts permitidos separados por coma (las entradas vacías se ignoran)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=uba_assistant_db
DB_USER=uba_user
DB_PASSWORD=uba_dev_password
DB_HOST=127.0.0.1
DB_PORT=5432

# OpenRouter: requerida para el chat; obtener en openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MAX_TOKENS=1200  # máximo de tokens del chat (opcional)

# Credenciales UBA opcionales para los comandos CLI de sincronización
# (sync_subjects, sync_professors, sync_evaluations). Si se omiten --ci/--password
# en el comando, se usan estas variables. Nunca se comitean: son credenciales locales.
UBA_USER_CI=
UBA_USER_PASSWD=

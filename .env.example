# SECRET_KEY: genera una con:
# .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# DEBUG: 1 en desarrollo, 0 en producción
DEBUG=1

# Hosts permitidos separados por coma (las entradas vacías se ignoran)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=uba_assistant_db
DB_USER=uba_user
DB_PASSWORD=uba_dev_password
DB_HOST=127.0.0.1
DB_PORT=5432

# OpenAI: opcional; requerida para el chat del asistente
OPENAI_API_KEY=
